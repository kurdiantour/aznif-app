+import assert from 'node:assert/strict';
+import { existsSync, readFileSync, readdirSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { test } from 'node:test';
+
+test('every static bundled asset reference exists on disk', () => {
+  for (const file of ['constants/catalog/tables.ts', 'constants/catalog/domino-sets.ts']) {
+    const source = readFileSync(file, 'utf8');
+    const assets = [...source.matchAll(/require\("@\/(assets\/cosmetics\/[^"\n]+)"\)/g)].map((m) => m[1]);
+    assert.ok(assets.length > 0);
+    for (const asset of assets) assert.ok(existsSync(resolve(asset)), `Missing bundle asset: ${asset}`);
+  }
+});
+
+test('Zagros references its own complete real artwork and no invented bundle', () => {
+  const files = readdirSync('assets/cosmetics/okey/zagros/tiles');
+  const expected = ['back.webp', 'fake-joker-1.webp', 'fake-joker-2.webp'];
+  for (const color of ['red', 'blue', 'black', 'yellow']) {
+    for (let n = 1; n <= 13; n++) expected.push(`${color}-${n}.webp`);
+  }
+  assert.deepEqual(files.sort(), expected.sort());
+  const source = readFileSync('constants/catalog/tables.ts', 'utf8');
+  for (const tile of expected) assert.ok(source.includes(`okey/zagros/tiles/${tile}`));
+  for (const asset of ['table.webp', 'shop-preview.webp', 'player-rack.webp', 'opponent-rack.webp']) {
+    assert.ok(source.includes(`okey/zagros/${asset}`));
+  }
+});
+
+test('the pending migration does not redefine multiplayer contracts or a public resolved view', () => {
+  const source = readFileSync('supabase/migrations/20260919193000_add_domino_sets.sql', 'utf8');
+  assert.doesNotMatch(source, /(?:CREATE|REPLACE)\s+FUNCTION\s+public\.get_multiplayer_room_/i);
+  assert.doesNotMatch(source, /CREATE\s+(?:OR\s+REPLACE\s+)?VIEW/i);
+  const engine = source.slice(source.indexOf('CREATE SCHEMA IF NOT EXISTS shop_private'));
+  assert.doesNotMatch(engine, /table-classic|domino-classic|zagros|emerald|skin-purple/);
+});
