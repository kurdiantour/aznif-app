{
  "name": "domino-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:security": "node scripts/production-security-check.js",
    "test:domino:timeout": "node --test scripts/turn-timeout-concurrency.test.mjs",
    "test:domino:waiting-room": "node --test scripts/domino-waiting-room-leave.test.mjs",
    "test:okey": "npm run test:okey:core && npm run test:okey:ui",
    "test:okey:core": "node --import ./scripts/test-typescript-loader.mjs --test --experimental-strip-types okey/engine/__tests__/*.test.ts okey/engine/__tests__/*.test.js okey/server/__tests__/*.test.ts okey/lifecycle/__tests__/*.test.ts okey/feedback/__tests__/*.test.ts",
    "test:okey:ui": "jest --config jest.okey.config.cjs --runInBand",
    "test:cloudflare:lifecycle": "node --test cloudflare/aznif-game-lifecycle/__tests__/*.test.mjs",
    "test:okey:ui:coverage": "jest --config jest.okey.config.cjs --runInBand --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:security && npm run test:domino:timeout && npm run test:domino:waiting-room",
    "build:android:apk": "npx eas-cli build --platform android --profile preview-apk",
    "build:android:production-apk": "npx eas-cli build --platform android --profile production-apk"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "2.106.1",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fbsdk-next": "13.4.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^1.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
